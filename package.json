{
  "name": "alfred-refoundation",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:alfred": "node scripts/dev-alfred.mjs",
    "runner:local": "ALFRED_ALLOW_DEV_CONFIG=1 RUNNER_API_URL=http://127.0.0.1:4301 ALFRED_SOURCES=codex ALFRED_RUNNER_LOOP=1 ALFRED_RUNNER_DB_PATH=apps/runner/.alfred-runner/outbox.sqlite tsx apps/runner/src/index.ts",
    "runner:service": "node scripts/runner-service.mjs",
    "runner:service:run": "node scripts/runner-service.mjs run",
    "runner:service:status": "node scripts/runner-service.mjs status",
    "runner:service:logs": "node scripts/runner-service.mjs logs",
    "lint": "turbo run lint",
    "smoke:cloud": "node scripts/cloud-smoke.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "agent:launch": "node scripts/launch-parallel-agents.mjs",
    "agent:monitor": "node scripts/monitor-parallel-agents.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "latest",
    "esbuild": "^0.28.0",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
