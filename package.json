{
  "name": "alfred-refoundation",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:alfred": "node scripts/dev-alfred.mjs",
    "lint": "eslint . --max-warnings 0",
    "smoke:electron": "pnpm --filter @alfred/desktop smoke:electron",
    "test": "node --test scripts/test/*.test.mjs && turbo run test",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "verify:quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm verify:quality && pnpm smoke:electron"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "turbo": "2.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@testing-library/dom@10.4.1>@babel/code-frame": "7.29.0",
      "@babel/code-frame@7.29.0>@babel/helper-validator-identifier": "7.28.5"
    },
    "onlyBuiltDependencies": []
  }
}
