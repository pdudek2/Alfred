# Local defaults
API_PORT=4301
WEB_PORT=4300
ALFRED_ALLOW_DEV_AUTH=1
ALFRED_ALLOW_DEV_CONFIG=1

# Postgres runtime. Use a pooled Neon URL in serverless runtime.
DATABASE_URL=postgresql://alfred:alfred@localhost:54329/alfred

# Postgres migrations. Use a direct Neon URL for Drizzle migration commands.
DATABASE_URL_UNPOOLED=postgresql://alfred:alfred@localhost:54329/alfred

# Local runner service
# Put real secrets in .secrets/runner.env, not in this file.
# The URL below is a local-development fallback. For preview/production runner
# service, set RUNNER_API_URL explicitly in .secrets/runner.env.
RUNNER_API_URL=http://127.0.0.1:4301
RUNNER_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
RUNNER_DEVICE_ID=00000000-0000-4000-8000-000000000101
# Local dev token only. Use a real non-default token in .secrets/runner.env and Vercel.
RUNNER_DEVICE_TOKEN=dev-device-token
ALFRED_SOURCES=codex
ALFRED_PRIVACY_MODE=standard
ALFRED_RUNNER_POLL_MS=5000

# Web/API auth
AUTH_DEV_SESSION_TOKEN=dev-session-token
APP_BASE_URL=http://127.0.0.1:4300
ALFRED_BOOTSTRAP_ADMIN_EMAIL=local@alfred.local
ALFRED_BOOTSTRAP_USER_ID=00000000-0000-4000-8000-000000000011
ALFRED_BOOTSTRAP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
