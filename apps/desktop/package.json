{
  "name": "@alfred/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "pnpm --filter @alfred/schema build && tsc -p tsconfig.main.json && node scripts/dev-electron.mjs",
    "smoke:electron": "install-electron && playwright test --config playwright.config.ts",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.eslint.json --noEmit"
  },
  "dependencies": {
    "@alfred/schema": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "lucide-react": "1.14.0",
    "node-pty": "^1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
