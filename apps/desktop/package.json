{
  "name": "@alfred/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.main.json && node scripts/dev-electron.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "typescript": "latest"
  }
}
